<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.alucardstudio.rellenadorex17.PrimaryController"
      alignment="CENTER"
      spacing="10"
      prefWidth="520"
      prefHeight="470">

    <padding>
        <Insets top="15" right="30" bottom="15" left="30"/>
    </padding>

    <Label text="RELLENADOR EX-17"
           style="-fx-font-size: 30px; -fx-font-weight: bold;"/>

    <Label text="Gestoría Merlino"
           style="-fx-font-size: 15px; -fx-text-fill: #666666;"/>

    <Label text="CONFIGURACIÓN CLÁSICA"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="Sube los documentos necesarios para generar un nuevo EX-17."/>

    <Button fx:id="btnSubirEx17"
            text="① Subir EX-17 lleno"
            prefWidth="320"
            prefHeight="38"
            onAction="#seleccionarEx17"/>

    <Label fx:id="lblEx17"
           text="Ningún archivo seleccionado"
           style="-fx-text-fill: #777777;"/>

    <Button fx:id="btnSubirResolucion" 
            text="② Subir resolución de concesión"
            prefWidth="220"
            prefHeight="38"
            onAction="#seleccionarResolucion"/>

    <Label fx:id="lblResolucion"
           text="Ningún archivo seleccionado"
           style="-fx-text-fill: #777777;"/>
    
    <Label fx:id="lblNie"
           text=""
           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

    <Button fx:id="btnContinuar"
            text="CONTINUAR →"
            prefWidth="220"
            prefHeight="48"
            disable="true"
            onAction="#continuar"/>
    
    <Button fx:id="btnNuevoEx17"
            text="+ NUEVO EX-17"
            prefWidth="220"
            prefHeight="42"
            visible="false"
            managed="false"
            onAction="#nuevoEx17"/>

    <Button text="⚙ Configuración avanzada"
            style="-fx-background-color: transparent;"
            onAction="#abrirConfiguracionAvanzada"/>
    
    <Button text="ℹ Acerca de"
        style="-fx-background-color: transparent;"
        onAction="#abrirAcercaDe"/>

</VBox>